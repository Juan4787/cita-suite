---
import '../styles/public.css';
import { bookingConfig } from '../lib/booking-config';
interface Props { title?: string }
const { title = 'Dra. Natalia Frutos · Medicina integrativa, del estrés y fitoterapia' } = Astro.props;
---
<!doctype html><html lang="es"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content="Conocé el enfoque de la Dra. Natalia Frutos y reservá tu consulta desde la agenda del consultorio."/><meta name="color-scheme" content="light dark"/><meta name="referrer" content="strict-origin-when-cross-origin"/><title>{title}</title>
  <link rel="preload" href="/fonts/newsreader.woff2" as="font" type="font/woff2" crossorigin/><link rel="preload" href="/fonts/hanken.woff2" as="font" type="font/woff2" crossorigin/>
  <script is:inline>try{const t=localStorage.getItem('nf_theme');if(t==='dark'||(!t&&matchMedia('(prefers-color-scheme: dark)').matches))document.documentElement.classList.add('dark')}catch{}</script>
</head><body data-booking-base={bookingConfig.baseURL} data-booking-key={bookingConfig.integrationKey}><a class="skip-link" href="#main">Saltar al contenido</a><slot/><script>import '../scripts/public';</script></body></html>
