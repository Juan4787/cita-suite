---
import { bookingConfig } from '../lib/booking-config';
import PublicLayout from '../layouts/PublicLayout.astro';
---
<PublicLayout title="Reservar consulta · Dra. Natalia Frutos">
  {bookingConfig.configured && <meta slot="head" http-equiv="refresh" content={`0;url=${bookingConfig.href}`} />}
  <main id="main" class="container booking-page"><h1>Reservar una consulta</h1>
    {bookingConfig.configured ? <><p role="status">Abriendo la agenda del consultorio…</p><a class="btn btn-primary" href={bookingConfig.href}>Ir al turnero</a></> : <p>La reserva online todavía no está habilitada.</p>}
    <a class="btn btn-secondary" href="/">Volver al sitio</a>
  </main>
</PublicLayout>
