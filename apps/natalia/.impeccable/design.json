      "css": ".ds-method{display:flex;flex-direction:column;background:var(--card,#FBF8F2);border:1px solid var(--line,rgba(30,26,22,.13));border-radius:var(--r-l,20px);padding:32px 28px;box-shadow:var(--shadow-1,0 1px 2px rgba(46,30,16,.06),0 2px 10px rgba(46,30,16,.05));transition:transform .3s var(--ease,cubic-bezier(.22,1,.36,1)),border-color .3s var(--ease,cubic-bezier(.22,1,.36,1))}.ds-method:hover{transform:translateY(-3px);border-color:var(--line-strong,rgba(30,26,22,.26))}.ds-method h3{font-family:var(--serif,'Newsreader',Georgia,serif);font-size:1.35rem;font-weight:400;line-height:1.22;color:var(--ink,#1E1A16);margin:0 0 10px}.ds-method p{font-family:var(--sans,'Hanken Grotesk',system-ui,sans-serif);font-size:.9rem;line-height:1.55;color:var(--ink-2,#463E36);margin:0}@media(prefers-reduced-motion:reduce){.ds-method{animation:none!important;transition:none!important}}"
