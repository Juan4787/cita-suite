      "html": "<div class=\"ds-signal\"><span class=\"ds-signal-num\">01</span><p class=\"ds-signal-text\">Dormís, pero no descansás.</p></div>",
      "css": ".ds-signal{display:flex;align-items:flex-start;gap:20px;padding:24px 28px;background:var(--card,#FBF8F2);border:1px solid var(--line,rgba(30,26,22,.13));border-radius:var(--r-m,12px);box-shadow:var(--shadow-1,0 1px 2px rgba(46,30,16,.06),0 2px 10px rgba(46,30,16,.05));transition:transform .25s var(--ease,cubic-bezier(.22,1,.36,1)),border-color .25s var(--ease,cubic-bezier(.22,1,.36,1)),box-shadow .25s var(--ease,cubic-bezier(.22,1,.36,1))}.ds-signal:hover{transform:translateY(-2px);border-color:var(--line-strong,rgba(30,26,22,.26));box-shadow:var(--shadow-2,0 2px 6px rgba(46,30,16,.06),0 18px 40px -12px rgba(46,30,16,.18))}.ds-signal-num{font-family:var(--serif,'Newsreader',Georgia,serif);font-style:italic;font-size:1.6rem;font-weight:700;line-height:1;min-width:32px;color:var(--accent,#A94B22)}.ds-signal-text{margin:0;font-family:var(--serif,'Newsreader',Georgia,serif);font-size:1.25rem;line-height:1.4;font-weight:500;color:var(--ink,#1E1A16)}@media(prefers-reduced-motion:reduce){.ds-signal,.ds-signal-text,.ds-signal-num{animation:none!important;transition:none!important}}"
