{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "cita-suite-scheduler",
	"account_id": "52b358653379c162b5a07b10ae5e84b3",
	"main": "src/index.ts",
	"compatibility_date": "2026-05-03",
	"workers_dev": false,
	"preview_urls": false,
	"triggers": {
		"crons": ["*/5 * * * *", "1-59/5 * * * *", "2-59/5 * * * *", "3-59/5 * * * *", "17 */3 * * *"]
	},
	"services": [{ "binding": "APP", "service": "app" }],
	"observability": { "enabled": true },
	"env": {
		"staging": {
			"name": "cita-suite-scheduler-staging",
			"triggers": {
				"crons": ["*/5 * * * *", "1-59/5 * * * *", "2-59/5 * * * *", "3-59/5 * * * *", "17 */3 * * *"]
			},
			"services": [{ "binding": "APP", "service": "cita-suite-staging" }],
			"observability": { "enabled": true }
		}
	}
}
